#!/bin/bash

find data_files_to_import/conflated-changes/ -name '*-city-conflict.osm' | sort | while read file;  do
  base=$(basename $file .osm);
  if [ ! -f "data_files_to_import/changesets/${base}.osc" ]; then
    echo $file
  fi
done | parallel -j 8 'echo {}; time ./changeset-from-conflated.php -v {}'
